# Vega Chatbot API (https://api.vegasystem.org/docs)
# Copia questo file in `.env` e compila i valori. NON committare `.env`.
#
# ⚠️ ATTENZIONE: le variabili con prefisso VITE_ finiscono nel bundle client.
# Credenziali VITE_VEGA_USER / VITE_VEGA_PASSWORD sono visibili a chiunque
# ispezioni il JavaScript dell'app. Migrare l'autenticazione a un proxy
# server-side (Vercel Function) per non esporre segreti nel client.

VITE_VEGA_API_URL=https://api.vegasystem.org
VITE_VEGA_WS_URL=wss://api.vegasystem.org/api/v1/ws
VITE_VEGA_USER=
VITE_VEGA_PASSWORD=
VITE_VEGA_ASSISTANT_ID=310
VITE_CHATBOT_COMING_SOON=false
VITE_GAMES_COMING_SOON=false
