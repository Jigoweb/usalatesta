# Chatbot embed "Usa la Testa" (Azure SWA + APIM / Direct Line)
# Copia in `.env` e compila. NON committare `.env`.
#
# partnerKey: subscription key APIM (visibile nel client; protetta da Origin whitelist + rate limit).
# Impostarla anche su Vercel Dashboard → Environment Variables (prefisso VITE_).
#
# Ambienti: i default sotto sono DEV. Prod (SWA/APIM/key) da aggiornare quando disponibili.
# Origin host deve essere in whitelist APIM (match esatto hostname).

VITE_USALATESTA_ASSET_BASE=https://blue-grass-07f595203.7.azurestaticapps.net
VITE_USALATESTA_TOKEN_URL=https://novoapim-dev-001.azure-api.net/usalatesta/generate
VITE_USALATESTA_PARTNER_KEY=
VITE_USALATESTA_USE_MOCK=false
# Opzionale: JSON array di stringhe, es. ["Domanda 1?","Domanda 2?"]
# VITE_USALATESTA_QUICK_ACTIONS=

VITE_CHATBOT_COMING_SOON=false
VITE_GAMES_COMING_SOON=false
