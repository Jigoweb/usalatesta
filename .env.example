# Chatbot Usa la Testa (widget di produzione)
# Copia in `.env` e compila. NON committare `.env`.
#
# La partnerKey NON va committata. Impostala su Vercel Dashboard
# solo per l'ambiente Production (i preview URL non sono in whitelist APIM):
#   Vercel → Project → Settings → Environment Variables
#   VITE_USALATESTA_PARTNER_KEY = <subscription key di prod>
#   Environment: Production
#
# Dopo aver impostato una variabile VITE_* serve un nuovo deploy:
# viene iniettata nel bundle in fase di build.

VITE_USALATESTA_PARTNER_KEY=
VITE_CHATBOT_COMING_SOON=false
VITE_GAMES_COMING_SOON=false
