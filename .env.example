# Vega Chatbot API (https://api.vegasystem.org/docs)
# Copia in `.env` e compila. NON committare `.env`.
#
# Le credenziali Vega (VEGA_USER, VEGA_PASSWORD) NON vanno qui:
# vanno impostate come variabili d'ambiente su Vercel Dashboard
# SENZA prefisso VITE_ → rimangono server-side nel Vercel Function.
#
# Vercel Dashboard → Project → Settings → Environment Variables:
#   VEGA_USER     = novomatic@vegasystem.org   (o nuovo dopo rotazione)
#   VEGA_PASSWORD = <nuova password>
#   VEGA_API_URL  = https://api.vegasystem.org  (opzionale, è il default)

VITE_VEGA_API_URL=https://api.vegasystem.org
VITE_VEGA_WS_URL=wss://api.vegasystem.org/api/v1/ws
VITE_VEGA_ASSISTANT_ID=310
VITE_CHATBOT_COMING_SOON=false
VITE_GAMES_COMING_SOON=false
